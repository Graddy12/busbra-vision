# Documentation only: the application does not automatically load this file.
# Set these variables in Railway. Never commit real values.
BUSBRA_PRODUCTION=1
BUSBRA_DATA_DIR=/data
# Required in production: choose a unique password with at least 16 characters.
BUSBRA_ADMIN_PASSWORD=
# Optional: otherwise a persistent random key is created on the data volume.
BUSBRA_SECRET_KEY=
INFERENCE_DEVICE=cpu
PORT=8080
